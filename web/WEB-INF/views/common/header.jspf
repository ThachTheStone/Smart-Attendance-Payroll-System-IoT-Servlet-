<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%-- Common header for authenticated views. Subpages declare taglibs + c:set pageTitle, activeNav then include this file.
     Layout: left sidebar (navigation grouped by task) + main column (top bar + page content). footer.jspf closes it. --%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> &bull; SmartAttend</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css?v=4.0">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/fonts.css?v=5">
    <link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/img/logo.svg">
</head>
<body class="app-shell">
<%-- Fixed number/date locale so fmt:formatNumber always groups thousands (otherwise it prints raw values when the browser sends no language). --%>
<fmt:setLocale value="en_US" scope="request"/>
<c:set var="me" value="${sessionScope.account}"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>

<aside class="sidebar" aria-label="Main navigation">
    <a class="sidebar-brand" href="${ctx}${me.role.homePath}" title="SmartAttend home">
        <span class="brand-mark"><img src="${ctx}/assets/img/logo-mark.svg" alt="" aria-hidden="true"></span>
        <span class="sidebar-brand-name">SmartAttend</span>
    </a>

    <nav class="sidebar-nav">
        <c:if test="${me.role == 'ADMIN'}">
            <div class="nav-group">
                <div class="nav-group-label">Overview</div>
                <a href="${ctx}/admin/dashboard" class="${activeNav == 'dashboard' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                    Dashboard
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-group-label">People</div>
                <a href="${ctx}/admin/users" class="${activeNav == 'users' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    Employees &amp; accounts
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-group-label">Time &amp; attendance</div>
                <a href="${ctx}/admin/attendance" class="${activeNav == 'attendance' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    Attendance
                </a>
                <a href="${ctx}/admin/shifts/schedule" class="${activeNav == 'shifts' || activeNav == 'holidays' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Schedule
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-group-label">Payroll</div>
                <a href="${ctx}/admin/payroll" class="${activeNav == 'payroll' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    Payroll &amp; payslips
                </a>
                <a href="${ctx}/admin/rules" class="${activeNav == 'rules' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
                    Salary rules
                </a>
            </div>
            <div class="nav-group">
                <div class="nav-group-label">Tools</div>
                <a href="${ctx}/kiosk" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                    Kiosk display
                </a>
                <a href="${ctx}/dev/simulator" class="${activeNav == 'simulator' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                    Device simulator
                </a>
            </div>
        </c:if>
        <c:if test="${me.role == 'STAFF'}">
            <div class="nav-group">
                <div class="nav-group-label">My work</div>
                <a href="${ctx}/staff/today" class="${activeNav == 'today' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Today
                </a>
                <a href="${ctx}/staff/schedule" class="${activeNav == 'schedule' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    My schedule
                </a>
                <a href="${ctx}/staff/payslips" class="${activeNav == 'payslips' ? 'active' : ''}">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    My payslips
                </a>
            </div>
        </c:if>
    </nav>

    <div class="sidebar-account">
        <div class="sidebar-user">
            <span class="sidebar-avatar" aria-hidden="true"><c:out value="${empty me.displayName ? '?' : me.displayName.substring(0, 1)}"/></span>
            <span>
                <span class="sidebar-user-name"><c:out value="${me.displayName}"/></span>
                <span class="sidebar-user-role"><c:out value="${me.role.label}"/></span>
            </span>
        </div>
        <div class="sidebar-account-links">
            <a href="${ctx}/account/password" class="${activeNav == 'password' ? 'active' : ''}">Change password</a>
            <a href="${ctx}/logout">Log out</a>
        </div>
    </div>
</aside>

<div class="app-main">
    <header class="app-topbar">
        <div class="app-topbar-title"><c:out value="${pageTitle}"/></div>
        <div class="app-topbar-date"><%= java.time.LocalDate.now().format(java.time.format.DateTimeFormatter.ofPattern("EEEE, d MMMM yyyy", java.util.Locale.ENGLISH)) %></div>
    </header>
    <main class="app-content">
        <c:if test="${not empty sessionScope.flash}">
            <div class="alert alert-${sessionScope.flash.type}">
                <c:out value="${sessionScope.flash.message}"/>
            </div>
            <c:remove var="flash" scope="session"/>
        </c:if>
